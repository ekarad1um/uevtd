{
  "inbound": {
    "path": "/run/uevtd/in.sock",
    "mode": "0660",
    "max_message_bytes": 65536,
    "max_connections": 64
  },
  "storage": {
    "path": "/var/lib/uevtd",
    "max_bytes": 268435456,
    "segment_bytes": 8388608,
    "sync_interval_ms": 0
  },
  "outbound": {
    "channels": {
      "ingest": {
        "type": "websocket",
        "enabled": true,
        "url": "wss://collector.example/ingest",
        "headers": { "Authorization": "Bearer replace-me" },
        "ca_file": null,
        "timeout_ms": 10000,
        "keep_alive_s": 30,
        "inflight": 256,
        "max_frame_bytes": 1048576
      },
      "broker": {
        "type": "mqtt",
        "enabled": false,
        "host": "broker.example",
        "port": 8883,
        "tls": true,
        "ca_file": null,
        "topic": "devices/42/events",
        "client_id": null,
        "username": null,
        "password": null,
        "qos": 1,
        "retain": false,
        "timeout_ms": 10000,
        "keep_alive_s": 30,
        "inflight": 32,
        "max_packet_bytes": 1048576
      }
    }
  },
  "api": { "path": "/run/uevtd/api.sock", "mode": "0660" },
  "log": { "filter": "info", "format": "text" }
}
