[Unit]
Description=uevtd message forwarding daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/uevtd --config /etc/uevtd/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
User=uevtd
Group=uevtd
RuntimeDirectory=uevtd
RuntimeDirectoryMode=0750
StateDirectory=uevtd
ConfigurationDirectory=uevtd
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
